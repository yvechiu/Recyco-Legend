{
  "name": "recyco-legend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html README.md docs .github",
    "format:check": "prettier --check src tests *.ts *.json index.html README.md docs .github"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
